@page "/"
@using System.Globalization
@inject IFinancialApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Processamento de Transação</PageTitle>

<MudPaper Class="pa-6" Elevation="2">
    <MudText Typo="Typo.h5" Class="mb-4">Processamento de Transação</MudText>

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
    }
    else if (_accounts is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudForm @ref="_form" Model="_model">
            <MudSelect T="Guid?" Label="Conta origem" @bind-Value="_model.SourceAccountId"
                       Required="true" RequiredError="Selecione a conta origem.">
                @foreach (var account in _accounts)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)account.Id)">@account.Number</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="Guid?" Label="Conta destino" @bind-Value="_model.DestinationAccountId"
                       Required="true" RequiredError="Selecione a conta destino." Class="mt-4">
                @foreach (var account in _accounts)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)account.Id)">@account.Number</MudSelectItem>
                }
            </MudSelect>

            <MudNumericField T="decimal?" Label="Valor" @bind-Value="_model.Amount" Class="mt-4"
                              Adornment="Adornment.Start" AdornmentText="R$" Format="N2" Culture="@_ptBr"
                              Min="0.01m" Required="true" RequiredError="Informe o valor." />

            @if (_submitError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_submitError</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       OnClick="SubmitAsync" Disabled="_isSubmitting">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                }
                CRIAR TRANSAÇÃO
            </MudButton>
        </MudForm>

        @if (_result is not null)
        {
            <MudPaper Class="pa-4 mt-6" Outlined="true">
                <MudText><b>ID:</b> @_result.Id</MudText>
                <MudText><b>Status:</b> @_result.Status</MudText>
            </MudPaper>
        }
    }
</MudPaper>

<MudPaper Class="pa-6 mt-6" Elevation="2">
    <MudText Typo="Typo.h5" Class="mb-4">Transações</MudText>

    @if (_gridError is not null)
    {
        <MudAlert Severity="Severity.Error">@_gridError</MudAlert>
    }
    else
    {
        <MudDataGrid T="TransactionResponse" Items="_transactions" Loading="_isLoadingTransactions"
                     SortMode="SortMode.Single" Filterable="false" Groupable="false">
            <Columns>
                <PropertyColumn Property="x => x.CreatedAtUtc" Title="Data de cadastro" InitialDirection="SortDirection.Descending">
                    <CellTemplate>
                        @context.Item.CreatedAtUtc.ToLocalTime().ToString("g", _ptBr)
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.SourceAccountId" Title="Conta origem" />
                <PropertyColumn Property="x => x.DestinationAccountId" Title="Conta destino" />
                <PropertyColumn Property="x => x.Amount" Title="Valor">
                    <CellTemplate>
                        @context.Item.Amount.ToString("C2", _ptBr)
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Status" Title="Status" />
                <TemplateColumn Title="Ações" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="() => DeleteTransactionAsync(context.Item)" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="TransactionResponse" />
            </PagerContent>
        </MudDataGrid>
    }
</MudPaper>

@code {
    private static readonly CultureInfo _ptBr = new("pt-BR");

    private MudForm? _form;
    private readonly TransactionFormModel _model = new();
    private IReadOnlyList<AccountResponse>? _accounts;
    private string? _loadError;
    private string? _submitError;
    private bool _isSubmitting;
    private TransactionResponse? _result;

    private IReadOnlyList<TransactionResponse> _transactions = [];
    private bool _isLoadingTransactions;
    private string? _gridError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await ApiClient.GetAccountsAsync();
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _loadError = "Não foi possível conectar à API. Verifique se ela está em execução.";
        }

        await LoadTransactionsAsync();
    }

    private async Task LoadTransactionsAsync()
    {
        _isLoadingTransactions = true;
        try
        {
            _transactions = await ApiClient.GetTransactionsAsync();
            _gridError = null;
        }
        catch (ApiException ex)
        {
            _gridError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _gridError = "Não foi possível conectar à API. Verifique se ela está em execução.";
        }
        finally
        {
            _isLoadingTransactions = false;
        }
    }

    private async Task DeleteTransactionAsync(TransactionResponse transaction)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir transação",
            $"Deseja realmente excluir a transação '{transaction.Id}'?",
            yesText: "Excluir", cancelText: "Cancelar");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await ApiClient.DeleteTransactionAsync(transaction.Id);
            Snackbar.Add("Transação excluída com sucesso.", Severity.Success);
            await LoadTransactionsAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Não foi possível conectar à API. Verifique se ela está em execução.", Severity.Error);
        }
    }

    private async Task SubmitAsync()
    {
        _submitError = null;
        _result = null;

        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        if (_model.SourceAccountId == _model.DestinationAccountId)
        {
            _submitError = "A conta origem deve ser diferente da conta destino.";
            return;
        }

        if (_model.Amount is null || _model.Amount <= 0)
        {
            _submitError = "O valor deve ser maior que zero.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var request = new CreateTransactionRequest(
                _model.SourceAccountId!.Value, _model.DestinationAccountId!.Value, _model.Amount!.Value);

            _result = await ApiClient.CreateTransactionAsync(request);
            Snackbar.Add("Transação criada com sucesso.", Severity.Success);
            await LoadTransactionsAsync();
        }
        catch (ApiException ex)
        {
            _submitError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _submitError = "Não foi possível conectar à API. Verifique se ela está em execução.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class TransactionFormModel
    {
        public Guid? SourceAccountId { get; set; }
        public Guid? DestinationAccountId { get; set; }
        public decimal? Amount { get; set; }
    }
}
